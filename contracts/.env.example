# -------------------------------------------------------------
# Jinn Token Deployment Environment Variables
# -------------------------------------------------------------
# WARNING: NEVER commit your actual .env file or real private keys!
# Keep your production keys in an offline hardware wallet / multi-sig safe.

# Deployer account private key (without 0x or with 0x)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# BSC RPC Endpoints (Optional custom nodes)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/

# BSCScan API Key for contract verification
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Multi-Sig Gnosis Safe Treasury Address (Recipient of initial supply / vesting)
TREASURY_SAFE_ADDRESS=0x0000000000000000000000000000000000000000
